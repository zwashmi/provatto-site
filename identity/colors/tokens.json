{
  "$schema": "https://design-tokens.org/draft",
  "meta": {
    "brand": "Provatto — بروفاتو",
    "version": "1.0.0",
    "direction_default": "rtl",
    "themes": ["light (default)", "dark (secondary)"],
    "note": "Design tokens for the Provatto Brand Operating System. Light warm off-white is the default product theme; dark navy is opt-in via .theme-dark. Values are AA-contrast tuned."
  },
  "color": {
    "brand": {
      "teal-500": { "value": "#12B5B0", "role": "primary action / accent" },
      "teal-600": { "value": "#0FA09B", "role": "hover / pressed" },
      "teal-700": { "value": "#0B706D", "role": "accent text / link on light (AA)" },
      "navy-900": { "value": "#0A111F", "role": "ink / dark bg" },
      "navy-800": { "value": "#132038", "role": "dark card surface" },
      "gold-500": { "value": "#C9A86A", "role": "seal / hairline (sparingly)" },
      "gold-ink": { "value": "#755E2E", "role": "gold text on light (AA)" }
    },
    "neutral": {
      "paper": { "value": "#F5F3EF", "role": "surface / page" },
      "paper-alt": { "value": "#FCFBF8", "role": "raised light" },
      "sink": { "value": "#EEEBE4", "role": "recessed surface" },
      "card": { "value": "#FFFFFF", "role": "card surface" },
      "hairline-warm": { "value": "#E7E2D9", "role": "divider" },
      "ink-2": { "value": "#565E6C", "role": "secondary text" },
      "ink-3": { "value": "#828A98", "role": "muted text" }
    },
    "semantic": {
      "success": { "value": "#1E8A57", "bg": "#E7F5EE" },
      "warning": { "value": "#8A6410", "bg": "#F8F1DF" },
      "error":   { "value": "#A5342E", "bg": "#F9EAE9" }
    }
  },
  "font": {
    "family": {
      "arabic": { "value": "IBM Plex Sans Arabic", "note": "primary Arabic face; DGA pending commercial license" },
      "latin":  { "value": "IBM Plex Sans" },
      "numeric":{ "value": "IBM Plex Sans", "note": "Latin digits always, even inside Arabic" }
    },
    "weight": { "light": 300, "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size":   { "caption": 13, "body": 15, "body-lg": 17, "h3": 20, "h2": 24, "h1": 30, "display": 40 },
    "line-height": { "arabic-body": 1.75, "arabic-heading": 1.35, "latin-body": 1.6 },
    "tracking": { "micro-label": "0.18em", "arabic": "0 (never letterspace Arabic)" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "screen-padding": 24 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "elevation": {
    "card": { "value": "0 1px 2px rgba(10,17,31,.05), 0 4px 16px rgba(10,17,31,.06)" },
    "raised": { "value": "0 8px 30px rgba(10,17,31,.14)" },
    "gold-glow": { "value": "0 0 0 1px rgba(201,168,106,.35), 0 6px 24px rgba(201,168,106,.12)" }
  },
  "motion": {
    "duration": { "fast": "150ms", "base": "240ms", "slow": "400ms" },
    "easing": { "standard": "cubic-bezier(.4,0,.2,1)" },
    "principles": "fades + small translates only; no bounce; honor prefers-reduced-motion"
  },
  "icon": { "grid": 24, "stroke": 1.5, "caps": "round", "joins": "round", "rtl_mirror": ["back","forward","transferOut","transferIn","note","share"] }
}
